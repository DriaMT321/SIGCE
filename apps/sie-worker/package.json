{
  "name": "@academic/sie-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker RPA Puppeteer para interoperabilidad y sincronización con el SIE",
  "scripts": {
    "prebuild": "pnpm --filter @academic/shared-types build",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:puppeteer": "tsx src/test-puppeteer.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@academic/shared-types": "workspace:*",
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "puppeteer": "^24.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
