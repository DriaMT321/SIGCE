# ==============================================================================
# ENVIRONMENT CONFIGURATION - SISTEMA DE GESTIÓN ACADÉMICA
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=5173
# IPs exactas del proxy inverso confiable; vacío desactiva X-Forwarded-For.
TRUSTED_PROXY_IPS=

# Database (PostgreSQL)
POSTGRES_USER=postgres
# Contraseña solo para desarrollo local; reemplázala antes de cualquier despliegue.
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=academic_management_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:change_me_local_only@localhost:5432/academic_management_db?schema=public

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication (JWT)
JWT_ACCESS_SECRET=local_access_secret_change_me_32_chars_min_sec12345
JWT_REFRESH_SECRET=local_refresh_secret_change_me_32_chars_min_sec12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Reemplaza ambos valores por secretos independientes de al menos 32 bytes aleatorios.
# For web deployment, set CORS_ORIGINS to exact HTTPS app origins and use
# WEB_COOKIE_SAME_SITE=none when the app and API are on different sites.

# Initial Seed Admin User (Development Bootstrap Only)
# Configure a unique local password of at least 8 UTF-8 bytes before seeding.
SEED_ADMIN_EMAIL=admin@sigce.edu.bo
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=General

# SIE Automation / RPA Configuration
SIE_BASE_URL=https://academico.sie.gob.bo
# Escritura directa en el SIE requiere doble confirmación explícita (falso por defecto)
SIE_REAL_WRITE_ENABLED=false
# Credenciales oficiales para el Worker RPA (solo si SIE_REAL_ACCESS_ENABLED=true)
SIE_USERNAME=
SIE_PASSWORD=
SIE_TEACHER_CODE=
SIE_IEC_ID=
# Identificadores de nivel y catálogo educativo SIE
SIE_NIVEL_ID=13
SIE_NIVEL_NAME=Secundaria Comunitaria Productiva
SIE_PRIMARY_NIVEL_ID=12
SIE_PRIMARY_NIVEL_NAME=Primaria Comunitaria Vocacional
SIE_CICLO_ID=1
SIE_IDIOMA_ID=48
SIE_NOTE_TEMPLATE=newTemplateDB
# Mapeo de período académico a idNotaTipo en SIE (1=primer trimestre: 6, etc.)
SIE_PERIOD_NOTE_TYPE_MAP=1:6,2:7,3:8
# Alias JSON de materias: {"CODIGO_SIGCE":"NOMBRE_OFICIAL_SIE"}
SIE_SUBJECT_ALIASES={}
SIE_ALLOW_FUZZY_SUBJECT_MATCH=false
# Selectores CSS opcionales para la pantalla de login del SIE
SIE_LOGIN_USER_SELECTOR=
SIE_LOGIN_PASSWORD_SELECTOR=
SIE_LOGIN_SUBMIT_SELECTOR=
# Scripts de consulta al portal real requieren habilitación manual y credenciales del entorno.
SIE_REAL_ACCESS_ENABLED=false
# SIE credentials are entered for each authorized operation and are not saved.
SIE_HEADLESS=true
# Optional local HTML replica, only for non-production tests; it is never the official portal.
# SIE_LOCAL_REPLICA_PATH=C:\\path\\to\\replica-calificaciones.html
SIE_SYNC_TIMEOUT_MS=30000
# Valores operativos iniciales; Dirección debe confirmarlos antes del despliegue institucional.
SIE_SYNC_DISCREPANCY_THRESHOLD=0.2
SIE_DISCREPANCY_DEADLINE_HOURS=72
# Keep the unvalidated real SIE audit endpoint disabled by default.
SIE_REAL_AUDIT_ENABLED=false

# Frontend Web Config
CORS_ORIGINS=http://localhost:5173
WEB_COOKIE_SAME_SITE=lax
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_SIE_REAL_AUDIT_ENABLED=false
