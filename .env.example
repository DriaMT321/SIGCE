# ==============================================================================
# ENVIRONMENT CONFIGURATION - SISTEMA DE GESTIÓN ACADÉMICA
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=5173

# Database (PostgreSQL)
POSTGRES_USER=academic_admin
POSTGRES_PASSWORD=academic_secret_password_2026
POSTGRES_DB=academic_management_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://academic_admin:academic_secret_password_2026@localhost:5432/academic_management_db?schema=public

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_change_in_production_32chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_change_in_production_32chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Initial Seed Admin User (Development Bootstrap Only)
SEED_ADMIN_EMAIL=admin@academic.edu.bo
SEED_ADMIN_PASSWORD=AdminSecurePass2026!
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=General

# SIE Automation / RPA Configuration (Placeholders - No Real Credentials)
SIE_BASE_URL=https://sie.minedu.gob.bo
SIE_USERNAME=sie_demo_user
SIE_PASSWORD=sie_demo_password
SIE_HEADLESS=true
SIE_SYNC_TIMEOUT_MS=30000

# Frontend Web Config
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
