# ==============================================================================
# ENVIRONMENT CONFIGURATION - SISTEMA DE GESTIÓN ACADÉMICA
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=5173

# Database (PostgreSQL)
POSTGRES_USER=academic_admin
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=academic_management_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://academic_admin:change_this_local_password@localhost:5432/academic_management_db?schema=public

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_ACCESS_SECRET=local_access_secret_change_me_32_chars_min
JWT_REFRESH_SECRET=local_refresh_secret_change_me_32_chars_min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Initial Seed Admin User (Development Bootstrap Only)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-this-bootstrap-password
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=General

# SIE Automation / RPA Configuration (Placeholders - No Real Credentials)
SIE_BASE_URL=
SIE_USERNAME=
SIE_PASSWORD=
SIE_HEADLESS=true
SIE_SYNC_TIMEOUT_MS=30000

# Frontend Web Config
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
