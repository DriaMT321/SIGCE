# ==============================================================================
# ENVIRONMENT CONFIGURATION - SISTEMA DE GESTIÓN ACADÉMICA
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=5173
# IPs exactas del proxy inverso confiable; vacío desactiva X-Forwarded-For.
TRUSTED_PROXY_IPS=

# Database (PostgreSQL)
POSTGRES_USER=postgres
# Contraseña solo para desarrollo local; reemplázala antes de cualquier despliegue.
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=academic_management_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:change_me_local_only@localhost:5432/academic_management_db?schema=public

# Cache and realtime (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication (JWT)
JWT_ACCESS_SECRET=local_access_secret_change_me_32_chars_min_sec12345
JWT_REFRESH_SECRET=local_refresh_secret_change_me_32_chars_min_sec12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Reemplaza ambos valores por secretos independientes de al menos 32 bytes aleatorios.
# For web deployment, set CORS_ORIGINS to exact HTTPS app origins and use
# WEB_COOKIE_SAME_SITE=none when the app and API are on different sites.

# Initial Seed Admin User (Development Bootstrap Only)
# Configure a unique local password of at least 8 UTF-8 bytes before seeding.
SEED_ADMIN_EMAIL=admin@sigce.edu.bo
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=General

# Frontend Web Config
CORS_ORIGINS=http://localhost:5173
WEB_COOKIE_SAME_SITE=lax
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000

# Origen exacto del complemento de Chrome, tras cargar su paquete en chrome://extensions.
# Ejemplo: chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
SIGCE_EXTENSION_ORIGIN=
